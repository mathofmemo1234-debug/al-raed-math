rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // سجلات المستخدمين وإدارة الجلسات النشطة (Single Active Session & User Roles)
    // مسموح بالقراءة والكتابة لتمكين المدير العام من اعتماد المستخدمين فورياً
    // وإدارة الجلسة النشطة الواحدة لمنع مشاركة الحسابات من أي جهاز أو متصفح
    match /users/{userId} {
      allow read, write: if true;
    }
    
    // تأمين بقية المستندات
    match /{document=**} {
      allow read: if true;
      allow write: if true;
    }
  }
}
