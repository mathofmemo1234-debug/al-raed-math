rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // سجلات المستخدمين والجلسات النشطة (Single Active Session & User Roles)
    match /users/{userId} {
      // السماح بالقراءة لأي مستخدم مسجل دخوله في المنصة
      allow read: if request.auth != null;
      
      // السماح بإنشاء الحساب عند أول تسجيل دخول
      allow create: if request.auth != null && request.auth.uid == userId;
      
      // السماح للمستخدم بتحديث جلسته النشطة فقط (activeSessionId) وبيانات جهازه
      // أو السماح للمدير العام (أ. محمد عبدالله جمعة) بتحديث الحساب كاملاً (الاعتماد/التعليق/إنهاء الجلسة)
      allow update: if request.auth != null && (
        (request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'approvedAt'])) ||
        request.auth.token.email in ['mohamed.gomaa@al-raed.edu.sa', 'mathofmemo1234@gmail.com']
      );
      
      // الحذف مقتصر على المدير العام فقط
      allow delete: if request.auth != null && request.auth.token.email in ['mohamed.gomaa@al-raed.edu.sa', 'mathofmemo1234@gmail.com'];
    }
    
    // تأمين بقية المستندات
    match /{document=**} {
      allow read: if true; // القراءة العامة للمناهج
      allow write: if request.auth != null && request.auth.token.email in ['mohamed.gomaa@al-raed.edu.sa', 'mathofmemo1234@gmail.com'];
    }
  }
}
